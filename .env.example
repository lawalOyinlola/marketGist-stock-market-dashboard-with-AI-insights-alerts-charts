# Database
# Local MongoDB: mongodb://localhost:27017/marketgist
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/marketgist
MONGODB_URI=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Finnhub API
# Get from: https://finnhub.io/
FINNHUB_API_KEY=

# Google Gemini AI
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Inngest
# Local dev: run the Inngest Dev Server (npx inngest-cli@latest dev) and set
# INNGEST_DEV=1. Inngest v4 defaults to cloud mode and needs a signing key.
# Production: set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from the Inngest
# dashboard and leave INNGEST_DEV unset.
# INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Email (Resend)
# API key: https://resend.com/api-keys (use "Sending access" for one domain)
RESEND_API_KEY=
# Bare address on a domain verified at https://resend.com/domains.
# The app adds the display name, so this sends as "Marketgist <address>".
EMAIL_FROM=alerts@your-verified-domain.com

# Optional: Disable Finnhub API for testing
# FINNHUB_DISABLE=false

# Optional: Sync database indexes on start (dev only)
# SYNC_INDEXES_ON_START=true
